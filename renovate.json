{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "deb",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*debian\\s+(?:suite=(?<suite>\\S+)\\s+)?depName=(?<depName>\\S+)\\s+(?:ARG|ENV)\\s+\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
            ],
            "registryUrlTemplate": "https://deb.debian.org/debian?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main,contrib,non-free&binaryArch=amd64",
            "versioningTemplate": "deb"
        },
        {
            "autoReplaceStringTemplate": "                    - {{depName}}-{{newValue}} # renovate: runner",
            "customType": "regex",
            "datasourceTemplate": "github-runners",
            "description": "Update GitHub runner labels in matrix.os",
            "managerFilePatterns": [
                "/^\\.github\\/workflows\\/test\\.ya?ml$/"
            ],
            "matchStrings": [
                "(?m)^\\s*-\\s*(?<depName>ubuntu|windows|macos)-(?<currentValue>latest|\\d{4}|\\d+(?:\\.\\d+)?)\\s*#\\s*renovate:\\s*runner\\s*$"
            ],
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "datasourceTemplate": "github-releases",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*github-release\\s+depName=(?<depName>\\S+)\\s+(?:ARG|ENV)\\s+\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
            ]
        }
    ],
    "extends": [
        "config:best-practices"
    ],
    "lockFileMaintenance": {
        "automerge": true,
        "enabled": true
    },
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "automerge": true,
            "matchDepTypes": [
                "devDependencies"
            ]
        },
        {
            "automerge": true,
            "matchCurrentVersion": "!/^0/",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        }
    ],
    "pre-commit": {
        "enabled": true
    }
}
